# Local development database. For Supabase, replace with its PostgreSQL
# connection string (prefer the Session pooler URL for hosted FastAPI).
DATABASE_URL=sqlite:///./potholevision.db

# Replace this before deploying the API publicly.
JWT_SECRET_KEY=local-development-only-change-this-key

# Comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://potholevision-seven.vercel.app

# Optional official dashboard gate. Leave empty to disable dashboard promotion.
# Use a six-digit numeric code and list only approved officials' registered account emails.
OFFICIAL_ACCESS_CODE=
OFFICIAL_ACCESS_EMAILS=
